<Window
    x:Class="Hookline.App.TrimWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Hookline.App"
    xmlns:audio="clr-namespace:Hookline.Audio;assembly=Hookline.Audio"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    Title="{x:Static local:AppStrings.WindowTitle}"
    Width="880"
    Height="700"
    MinWidth="760"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanMinimize"
    Background="{StaticResource WindowBackgroundBrush}"
    PreviewKeyDown="OnPreviewKeyDown">
    <Border
        BorderBrush="#343B48"
        BorderThickness="1"
        Background="{StaticResource WindowBackgroundBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="-4,-8,-4,12"
                Background="Transparent"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Semibold"
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{x:Static local:AppStrings.WindowTitle}" />
                <Button
                    HorizontalAlignment="Right"
                    Width="34"
                    Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    automation:AutomationProperties.Name="{x:Static local:AppStrings.Close}"
                    Click="OnCloseClick"
                    Content="✕" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="8"
                    Background="#242A36"
                    ClipToBounds="True">
                    <Grid>
                        <TextBlock
                            x:Name="AlbumArtPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Semibold"
                            FontSize="24"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="♪" />
                        <Image
                            x:Name="AlbumArtImage"
                            Stretch="UniformToFill"
                            automation:AutomationProperties.Name="{x:Static local:AppStrings.AlbumArtDescription}" />
                    </Grid>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="14,4,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Segoe UI Semibold"
                        FontSize="22"
                        Text="{Binding TrackTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding TrackArtist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <local:WaveformControl
                x:Name="Waveform"
                Grid.Row="2"
                Margin="0,0,0,8"
                IsEnabled="{Binding CanEditSelection}"
                ActiveEdgeChanged="OnWaveformActiveEdgeChanged"
                SelectionChanged="OnWaveformSelectionChanged">
                <local:WaveformControl.Style>
                    <Style TargetType="local:WaveformControl">
                        <Setter Property="MinHeight" Value="140" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding IsEqualizerExpanded}"
                                Value="True">
                                <Setter
                                    Property="MinHeight"
                                    Value="80" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:WaveformControl.Style>
            </local:WaveformControl>

            <TextBlock
                Grid.Row="3"
                Margin="2,0,0,14"
                FontSize="12"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{x:Static local:AppStrings.FineAdjustHint}" />

            <Grid
                Grid.Row="4"
                Margin="0,0,0,13"
                IsEnabled="{Binding CanEditSelection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="13,10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.Start}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="15"
                                Text="{Binding SelectionStartText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="31"
                                Height="31"
                                Margin="0,0,5,0"
                                Padding="0"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.NudgeStartEarlier}"
                                Click="OnNudgeStartEarlier"
                                GotKeyboardFocus="OnStartControlFocused"
                                Content="{x:Static local:AppStrings.Earlier}" />
                            <Button
                                Width="31"
                                Height="31"
                                Padding="0"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.NudgeStartLater}"
                                Click="OnNudgeStartLater"
                                GotKeyboardFocus="OnStartControlFocused"
                                Content="{x:Static local:AppStrings.Later}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="13,10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.End}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="15"
                                Text="{Binding SelectionEndText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="31"
                                Height="31"
                                Margin="0,0,5,0"
                                Padding="0"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.NudgeEndEarlier}"
                                Click="OnNudgeEndEarlier"
                                GotKeyboardFocus="OnEndControlFocused"
                                Content="{x:Static local:AppStrings.Earlier}" />
                            <Button
                                Width="31"
                                Height="31"
                                Padding="0"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.NudgeEndLater}"
                                Click="OnNudgeEndLater"
                                GotKeyboardFocus="OnEndControlFocused"
                                Content="{x:Static local:AppStrings.Later}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="4"
                    Padding="13,10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{x:Static local:AppStrings.Selection}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontFamily="Consolas"
                            FontSize="15"
                            Text="{Binding SelectionDurationText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="5"
                Margin="0,0,0,12"
                Padding="13,10"
                Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="8"
                IsEnabled="{Binding AreEffectsEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock
                            DockPanel.Dock="Right"
                            FontSize="10"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{x:Static local:AppStrings.EffectsLimitHint}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{x:Static local:AppStrings.EffectsLimitHint}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{x:Static local:AppStrings.Effects}" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.EditStyle}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontFamily="Segoe UI Semibold"
                                FontSize="11"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{Binding EditEffectPresetText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Padding="9,4"
                                FontSize="10"
                                Tag="{x:Static audio:EditEffectPreset.SlowedReverb}"
                                Click="OnEditEffectPresetClick"
                                Content="{x:Static local:AppStrings.SlowedReverb}" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="9,4"
                                FontSize="10"
                                Tag="{x:Static audio:EditEffectPreset.SpedUp}"
                                Click="OnEditEffectPresetClick"
                                Content="{x:Static local:AppStrings.SpedUp}" />
                            <Button
                                Padding="9,4"
                                FontSize="10"
                                Tag="{x:Static audio:EditEffectPreset.EightDAudio}"
                                Click="OnEditEffectPresetClick"
                                Content="{x:Static local:AppStrings.EightDAudio}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding SpeedMultiplierText}" />
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Static local:AppStrings.Speed}" />
                            </DockPanel>
                            <Slider
                                Margin="0,5,0,0"
                                Minimum="0.5"
                                Maximum="2"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.Speed}"
                                Value="{Binding SpeedMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding ReverbAmountText}" />
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Static local:AppStrings.Reverb}" />
                            </DockPanel>
                            <Slider
                                Margin="0,5,0,0"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.Reverb}"
                                Value="{Binding ReverbAmountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding RotationRateText}" />
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Static local:AppStrings.Rotation}" />
                            </DockPanel>
                            <Slider
                                Margin="0,5,0,0"
                                Minimum="0"
                                Maximum="0.25"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.Rotation}"
                                automation:AutomationProperties.HelpText="{x:Static local:AppStrings.HeadphonesHint}"
                                Value="{Binding RotationRateHertz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="9"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.HeadphonesHint}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    FontFamily="Consolas"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding LoopCountText}" />
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Static local:AppStrings.Loop}" />
                            </DockPanel>
                            <Slider
                                Margin="0,5,0,0"
                                Minimum="1"
                                Maximum="64"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.Loop}"
                                Value="{Binding LoopCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.Equalizer}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontFamily="Segoe UI Semibold"
                                FontSize="11"
                                Foreground="{StaticResource AccentBrush}"
                                Text="{Binding EqualizerPresetText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.Flat}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.EqualizerFlat}" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.BassBoost}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.BassBoost}" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.TrebleBoost}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.EqualizerTrebleBoost}" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.Vocal}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.EqualizerVocal}" />
                            <Button
                                Margin="0,0,5,0"
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.Bright}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.EqualizerBright}" />
                            <Button
                                Padding="8,4"
                                FontSize="10"
                                Tag="{x:Static audio:EqualizerPreset.Mellow}"
                                Click="OnEqualizerPresetClick"
                                Content="{x:Static local:AppStrings.EqualizerMellow}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Padding="9,4"
                            FontSize="10"
                            Click="OnToggleEqualizerClick"
                            Content="{Binding EqualizerExpandButtonText}" />
                    </Grid>

                    <Border
                        Grid.Row="4"
                        Margin="0,10,0,0"
                        Padding="8"
                        Background="#111620"
                        CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEqualizerExpanded}"
                                        Value="True">
                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding EqualizerBands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Foreground="{StaticResource AccentBrush}"
                                            Text="{Binding GainText}" />
                                        <Slider
                                            Height="72"
                                            Margin="0,3"
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical"
                                            Minimum="-12"
                                            Maximum="12"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            AutoToolTipPlacement="TopLeft"
                                            AutoToolTipPrecision="0"
                                            automation:AutomationProperties.Name="{Binding Description}"
                                            Value="{Binding GainDecibels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="{Binding FrequencyText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="6"
                Margin="0,0,0,12"
                Padding="13,10"
                Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.StemIsolation}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.StemIsolationSlowHint}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <CheckBox
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding AreEffectsEnabled}"
                                IsChecked="{Binding IsSixStemExperimental, Mode=TwoWay}"
                                Content="{x:Static local:AppStrings.SixStemExperimental}" />
                            <Button
                                MinWidth="112"
                                Padding="10,5"
                                IsEnabled="{Binding CanIsolateStems}"
                                Click="OnIsolateStemsClick"
                                Content="{x:Static local:AppStrings.IsolateStems}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,7,0,0"
                        FontSize="10"
                        Foreground="{StaticResource WarningBrush}"
                        Text="{x:Static local:AppStrings.StemExperimentalHint}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSixStemExperimental}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsStemSeparating}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            Height="8"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding StemProgressPercent, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding StemProgressText}" />
                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            IsEnabled="{Binding CanCancelStemIsolation}"
                            Click="OnCancelStemIsolationClick"
                            Content="{x:Static local:AppStrings.CancelStemIsolation}" />
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,9,0,0"
                        Padding="8"
                        Background="#111620"
                        CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding HasSeparatedStems}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="6,0,6,7">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{x:Static local:AppStrings.StemMixView}" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,5,0"
                                        Padding="9,4"
                                        FontSize="10"
                                        Click="OnShowStemSlidersClick"
                                        Content="{x:Static local:AppStrings.StemSlidersView}">
                                        <Button.Style>
                                            <Style
                                                TargetType="Button"
                                                BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsStemSliderView}"
                                                        Value="True">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                        <Setter
                                                            Property="Background"
                                                            Value="#263A38" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Padding="9,4"
                                        FontSize="10"
                                        Click="OnShowStemBandClick"
                                        Content="{x:Static local:AppStrings.StemBandView}">
                                        <Button.Style>
                                            <Style
                                                TargetType="Button"
                                                BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsStemBandView}"
                                                        Value="True">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                        <Setter
                                                            Property="Background"
                                                            Value="#263A38" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Margin="6,0,6,7"
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.StemBandHint}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsStemBandView}"
                                                Value="True">
                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl
                                Grid.Row="2"
                                ItemsSource="{Binding StemVolumes}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsStemSliderView}"
                                                Value="True">
                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,0">
                                            <DockPanel>
                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    Margin="6,0,0,0"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Text="{Binding VolumeText}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="{Binding Name}" />
                                            </DockPanel>
                                            <Slider
                                                Margin="0,4,0,0"
                                                Minimum="0"
                                                Maximum="150"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="True"
                                                automation:AutomationProperties.Name="{Binding Name}"
                                                Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl
                                Grid.Row="2"
                                IsEnabled="{Binding AreEffectsEnabled}"
                                ItemsSource="{Binding StemVolumes}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsStemBandView}"
                                                Value="True">
                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="11"
                                                Text="{Binding Name}" />
                                            <local:StemBandAvatarControl
                                                Height="132"
                                                MinWidth="64"
                                                Margin="0,3"
                                                automation:AutomationProperties.Name="{Binding Name}"
                                                automation:AutomationProperties.HelpText="{x:Static local:AppStrings.StemBandHint}"
                                                StemKind="{Binding Kind}"
                                                VolumePercent="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="{Binding BandVolumeText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="7" Margin="0,0,0,12">
                <Border
                    x:Name="ExcludedWarning"
                    Margin="0,0,0,8"
                    Padding="11,8"
                    Background="#2B221A"
                    BorderBrush="#805B37"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectionOverlapsExcluded}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource WarningBrush}"
                        Text="{x:Static local:AppStrings.ExcludedWarning}"
                        TextWrapping="Wrap" />
                </Border>
                <TextBlock
                    MinHeight="18"
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusMessage}" />
            </StackPanel>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="9"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{x:Static local:AppStrings.OutputFolder}" />
                    <DockPanel Margin="0,3,18,0">
                        <Button
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Padding="8,3"
                            FontSize="11"
                            Click="OnChangeFolderClick"
                            Content="{x:Static local:AppStrings.ChangeFolder}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding OutputFolder}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding OutputFolder}" />
                    </DockPanel>
                    <Border
                        Margin="0,8,18,0"
                        Padding="9,6"
                        Background="#202A2A"
                        BorderBrush="#365D50"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding ShowSpotifyLocalFilesHint}"
                                        Value="True">
                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button
                                DockPanel.Dock="Right"
                                Margin="10,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="{x:Static local:AppStrings.DismissSpotifyLocalFilesHint}"
                                Click="OnDismissSpotifyHintClick"
                                Content="{x:Static local:AppStrings.DismissSpotifyLocalFilesHint}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{x:Static local:AppStrings.SpotifyLocalFilesHint}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        MinWidth="105"
                        Margin="0,0,9,0"
                        IsEnabled="{Binding CanPreview}"
                        Click="OnPreviewClick"
                        Content="{Binding PreviewButtonText}" />
                    <Button
                        MinWidth="126"
                        Background="#247B5C"
                        BorderBrush="#5BE7B1"
                        IsDefault="True"
                        IsEnabled="{Binding CanExport}"
                        Click="OnExportClick"
                        Content="{Binding ExportButtonText}" />
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</Window>
