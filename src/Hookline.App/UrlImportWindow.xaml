<Window
    x:Class="Hookline.App.UrlImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalog="clr-namespace:Hookline.App.Catalog"
    xmlns:local="clr-namespace:Hookline.App"
    Title="{x:Static local:AppStrings.UrlImportWindowTitle}"
    Width="560"
    Height="600"
    MinWidth="500"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBackgroundBrush}"
    ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <catalog:AlbumArtBytesToImageConverter x:Key="AlbumArtConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                FontFamily="Segoe UI Semibold"
                FontSize="25"
                Text="{x:Static local:AppStrings.UrlImportHeading}" />
            <TextBlock
                Margin="0,7,0,0"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{x:Static local:AppStrings.UrlImportSubtitle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,18,0,0"
            Padding="12"
            Background="#2A2318"
            BorderBrush="{StaticResource WarningBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Visibility="{Binding IsNoticeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{x:Static local:AppStrings.UrlImportPersonalUseNotice}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Padding="10,5"
                    Click="OnDismissNoticeClick"
                    Content="{x:Static local:AppStrings.UrlImportDismissNotice}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock
                FontFamily="Segoe UI Semibold"
                FontSize="11"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{x:Static local:AppStrings.UrlImportLabel}" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="UrlTextBox"
                    MinHeight="38"
                    Padding="10,8"
                    VerticalContentAlignment="Center"
                    Background="#151922"
                    BorderBrush="#353D4B"
                    BorderThickness="1"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    IsReadOnly="{Binding IsBusy, Mode=OneWay}"
                    Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Click="OnFetchClick"
                    Content="{x:Static local:AppStrings.UrlImportFetch}"
                    IsDefault="True"
                    IsEnabled="{Binding CanFetch, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Border
            Grid.Row="3"
            Margin="0,20,0,0"
            Padding="16"
            Background="{StaticResource PanelBackgroundBrush}"
            CornerRadius="9"
            Visibility="{Binding HasPreview, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="150"
                    Height="112"
                    Background="#0B0E13"
                    CornerRadius="6"
                    ClipToBounds="True">
                    <Image
                        Source="{Binding Thumbnail, Mode=OneWay, Converter={StaticResource AlbumArtConverter}}"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="18,2,0,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        FontFamily="Segoe UI Semibold"
                        FontSize="18"
                        Text="{Binding Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding Channel, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding DurationText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <ProgressBar
                x:Name="DownloadProgressBar"
                Height="6"
                IsIndeterminate="{Binding IsResolving, Mode=OneWay}"
                Maximum="100"
                Value="{Binding ProgressPercent, Mode=OneWay}"
                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock
                Margin="0,9,0,0"
                Foreground="{StaticResource MutedTextBrush}"
                Text="{Binding StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                HorizontalAlignment="Left"
                Click="OnCancelClick"
                Content="{x:Static local:AppStrings.UrlImportCancel}"
                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Click="OnCloseClick"
                Content="{x:Static local:AppStrings.UrlImportClose}" />
            <Button
                Grid.Column="2"
                Background="#216B53"
                BorderBrush="{StaticResource AccentBrush}"
                Click="OnImportClick"
                Content="{x:Static local:AppStrings.UrlImportConfirm}"
                IsEnabled="{Binding CanImport, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
